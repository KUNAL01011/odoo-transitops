generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// ================================================================
// ENUMS
// ================================================================

enum Role {
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum UserStatus {
  ACTIVE
  LOCKED // auto-set after 5 failed login attempts (mockup Screen 0)
  INACTIVE
}

enum VehicleType {
  VAN
  TRUCK
  MINI_TRUCK
  BUS
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum LicenseCategory {
  LMV
  HMV
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  ACTIVE // vehicle is "In Shop" while a record has this status
  COMPLETED
}

enum ExpenseType {
  TOLL
  OTHER
}

enum NotificationType {
  LICENSE_EXPIRING
  TRIP_DISPATCHED
  TRIP_COMPLETED
  TRIP_CANCELLED
  MAINTENANCE_OPENED
  MAINTENANCE_CLOSED
  ACCOUNT_LOCKED
}

enum AppModule {
  DASHBOARD
  FLEET
  DRIVERS
  TRIPS
  MAINTENANCE
  FUEL_EXPENSES
  ANALYTICS
  SETTINGS
}

// ================================================================
// AUTH / RBAC
// ================================================================

model User {
  id                  Int        @id @default(autoincrement())
  name                String
  email               String     @unique
  passwordHash        String
  role                Role
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([role])
}

// Drives Screen 8 (Settings & RBAC) — the matrix of which role can
// view/edit which module. Seed this with the defaults implied by the
// spec's role descriptions; edit it live from Settings.
model RolePermission {
  id      Int       @id @default(autoincrement())
  role    Role
  module  AppModule
  canView Boolean   @default(false)
  canEdit Boolean   @default(false)

  @@unique([role, module])
}

// Singleton row — General tab of Screen 8 (Notify Alert / Currency /
// Distance Unit + Save Changes).
model SystemSettings {
  id               Int      @id @default(1)
  licenseAlertDays Int      @default(30)
  currency         String   @default("INR")
  distanceUnit     String   @default("km")
  updatedAt        DateTime @updatedAt
}

// ================================================================
// FLEET
// ================================================================

model Vehicle {
  id              Int           @id @default(autoincrement())
  regNo           String        @unique
  name            String // Name/Model column
  type            VehicleType
  maxLoadCapacity Float // kg — capacity check in Trip Dispatcher
  odometer        Float         @default(0)
  acquisitionCost Float
  status          VehicleStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  @@index([status])
  @@index([type])
}

// ================================================================
// DRIVERS
// ================================================================

model Driver {
  id              Int             @id @default(autoincrement())
  name            String
  licenseNumber   String          @unique
  licenseCategory LicenseCategory
  licenseExpiry   DateTime
  contactNumber   String
  safetyScore     Int             @default(100)
  tripCompletions Int             @default(0)
  status          DriverStatus    @default(AVAILABLE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trips Trip[]

  @@index([status])
}

// ================================================================
// TRIPS
// ================================================================

model Trip {
  id                 Int        @id @default(autoincrement())
  tripCode           String     @unique // e.g. TR001, auto-generated
  source             String
  destination        String
  vehicleId          Int?
  driverId           Int?
  cargoWeight        Float
  plannedDistance    Float
  finalOdometer      Float? // captured on Complete
  fuelConsumedLiters Float? // captured on Complete
  status             TripStatus @default(DRAFT)
  cancellationReason String?
  dispatchedAt       DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  fuelLogs FuelLog[]

  @@index([status])
}

// ================================================================
// MAINTENANCE
// ================================================================

model MaintenanceLog {
  id          Int                @id @default(autoincrement())
  vehicleId   Int
  serviceType String
  description String?
  cost        Float
  date        DateTime
  status      MaintenanceStatus  @default(ACTIVE)
  photoUrl    String?
  closedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([status])
}

// ================================================================
// FUEL & EXPENSES
// ================================================================

model FuelLog {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  tripId    Int?
  liters    Float
  cost      Float
  date      DateTime
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])
}

model Expense {
  id          Int         @id @default(autoincrement())
  vehicleId   Int
  type        ExpenseType
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ================================================================
// NOTIFICATIONS
// ================================================================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int? // null + role = broadcast to every user of that role
  role      Role?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([role])
  @@index([isRead])
}

// ================================================================
// AUDIT LOG (bonus — "who did what, when")
// ================================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String // e.g. "TRIP_DISPATCHED", "VEHICLE_RETIRED"
  entity    String // e.g. "Trip", "Vehicle"
  entityId  Int?
  metadata  String? // JSON string of before/after or extra context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity])
}
