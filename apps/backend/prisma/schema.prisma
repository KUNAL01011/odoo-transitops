generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FLEET_MANAGER
  DISPATCHER
  SAFETY_OFFICER
  FINANCIAL_ANALYST
}

enum UserStatus {
  ACTIVE 
  LOCKED
  INACTIVE
}

enum VehicleType {
  VAN
  TRUCK
  MINI_TRUCK
  BUS
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  IN_SHOP
  RETIRED
}

enum LicenseCategory {
  LMV
  HMV
  OTHER
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  SUSPENDED
}

enum TripStatus {
  DRAFT
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  ACTIVE 
  COMPLETED
}

enum ExpenseType {
  TOLL
  OTHER
}


enum NotificationType {
  LICENSE_EXPIRING
  TRIP_DISPATCHED
  TRIP_COMPLETED
  TRIP_CANCELLED
  MAINTENANCE_OPENED
  MAINTENANCE_CLOSED
  ACCOUNT_LOCKED
}

enum AppModule {
  DASHBOARD
  FLEET
  DRIVERS
  TRIPS
  MAINTENANCE
  FUEL_EXPENSES
  ANALYTICS
  SETTINGS
}

model User {
  id                  String        @id @default(uuid())
  name                String
  email               String     @unique
  passwordHash        String
  role                Role
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  resetToken          String?
  resetTokenExpiry    DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([role])
}

model RolePermission {
  id      String       @id @default(uuid())
  role    Role
  module  AppModule
  canView Boolean   @default(false)
  canEdit Boolean   @default(false)

  @@unique([role, module])
}

model SystemSettings {
  id               String      @id @default(uuid())
  licenseAlertDays Int      @default(30)
  currency         String   @default("INR")
  distanceUnit     String   @default("km")
  updatedAt        DateTime @updatedAt
}

model Vehicle {
  id              String           @id @default(uuid())
  regNo           String        @unique
  name            String // Name/Model column
  type            VehicleType
  maxLoadCapacity Float // kg — capacity check in Trip Dispatcher
  odometer        Float         @default(0)
  acquisitionCost Float
  status          VehicleStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trips           Trip[]
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  expenses        Expense[]

  @@index([status])
  @@index([type])
}

model Driver {
  id              String             @id @default(uuid())
  name            String
  licenseNumber   String          @unique
  licenseCategory LicenseCategory
  licenseExpiry   DateTime
  contactNumber   String
  safetyScore     Int             @default(100)
  tripCompletions Int             @default(0)
  status          DriverStatus    @default(AVAILABLE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  trips Trip[]

  @@index([status])
}

model Trip {
  id                 String        @id @default(uuid())
  tripCode           String     @unique // e.g. TR001, auto-generated
  source             String
  destination        String
  vehicleId          String?
  driverId           String?
  cargoWeight        Float
  plannedDistance    Float
  finalOdometer      Float? // captured on Complete
  fuelConsumedLiters Float? // captured on Complete
  status             TripStatus @default(DRAFT)
  cancellationReason String?
  dispatchedAt       DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id])
  driver   Driver?   @relation(fields: [driverId], references: [id])
  fuelLogs FuelLog[]

  @@index([status])
}

model MaintenanceLog {
  id          String                @id @default(uuid())
  vehicleId   String
  serviceType String
  description String?
  cost        Float
  date        DateTime
  status      MaintenanceStatus  @default(ACTIVE)
  photoUrl    String?
  closedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([status])
}

model FuelLog {
  id        String      @id @default(uuid())
  vehicleId String
  tripId    String?
  liters    Float
  cost      Float
  date      DateTime
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  trip    Trip?   @relation(fields: [tripId], references: [id])
}

model Expense {
  id          String         @id @default(uuid())
  vehicleId   String
  type        ExpenseType
  amount      Float
  date        DateTime
  description String?
  createdAt   DateTime    @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String? // null + role = broadcast to every user of that role
  role      Role?
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([role])
  @@index([isRead])
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String
  action    String // e.g. "TRIP_DISPATCHED", "VEHICLE_RETIRED"
  entity    String // e.g. "Trip", "Vehicle"
  entityId  Int?
  metadata  String? // JSON string of before/after or extra context
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entity])
}